APP_PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=isi_kata_sandi_anda
DB_NAME=praktikum_backend
DB_SSLMODE=disable
DB_MAX_CONNS=10

# MongoDB - portofolio student
MONGO_URI=mongodb://localhost:27017
MONGO_DB=praktikum_backend
MONGO_TIMEOUT_SECONDS=10

# Auth - ganti dengan: openssl rand -hex 32
JWT_SECRET=isi_dengan_minimal_32_karakter_acak_disini
JWT_ISSUER=praktikum-backend
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
ALLOWED_ORIGINS=http://localhost:5173

# Redis + background job (Modul 11)
# WORKER_CONCURRENCY harus lebih kecil dari DB_MAX_CONNS (satu task memegang
# satu koneksi DB selama email dikirim).
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
WORKER_CONCURRENCY=5
RELAY_INTERVAL_MS=1000
RELAY_BATCH=100
MAILER_DELAY_MS=1500
MAILER_FAIL_EVERY=0

# Swagger UI di /swagger/index.html (Modul 12). Matikan di production.
SWAGGER_ENABLED=false
